{
  "name": "Employee",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Nome completo do funcion\u00e1rio"
    },
    "email": {
      "type": "string",
      "description": "Email do funcion\u00e1rio"
    },
    "employee_number": {
      "type": "string",
      "description": "N\u00famero do funcion\u00e1rio"
    },
    "sector_id": {
      "type": "string",
      "description": "ID do setor"
    },
    "position_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos cargos"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Papel no sistema"
    },
    "user_id": {
      "type": "string",
      "description": "ID do utilizador Base44 associado"
    },
    "invite_status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "default": "pending",
      "description": "Estado interno da conta"
    },
    "activation_token": {
      "type": "string",
      "description": "Token de ativa\u00e7\u00e3o de conta (uso interno)"
    }
  },
  "required": [
    "display_name",
    "email"
  ]
}