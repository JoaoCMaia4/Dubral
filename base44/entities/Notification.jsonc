{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do utilizador destinat\u00e1rio"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "message": {
      "type": "string",
      "description": "Mensagem da notifica\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "survey_new",
        "survey_deadline",
        "system"
      ],
      "description": "Tipo de notifica\u00e7\u00e3o"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Se foi lida"
    },
    "survey_id": {
      "type": "string",
      "description": "ID do question\u00e1rio associado"
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}